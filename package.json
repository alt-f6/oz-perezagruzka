{
  "name": "oz-perezagruzka",
  "version": "0.1.0",
  "private": false,
  "description": "Multi-tenant Next.js platform for a Russian online tutoring school: landing, CRM, and LMS in one app.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/qa-invariants.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "logs": "docker compose -f docker-compose.prod.yml logs -f --tail=200 app | tsx scripts/format-logs.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/react": "^4.0.30",
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "ai": "^7.0.28",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dbmate": "^2.28.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "openai": "^7.5.0",
    "pdfjs-dist": "^5.4.530",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.10.1",
    "resend": "^6.19.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@prisma/config": "^7.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^8.0.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.5",
    "prisma": "^7.9.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run lint -- --fix",
      "bash -c 'tsc --noEmit'"
    ]
  }
}
