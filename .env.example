# Postgres connection used by the Prisma client at runtime. For the
# self-hosted docker-compose.prod.yml setup (db co-located on this server),
# this points at the `db` service on the compose network:
#   postgresql://app:<POSTGRES_PASSWORD>@db:5432/app?schema=public
# If instead using a managed provider (Neon/Supabase), use its pooled
# connection string and also set DIRECT_URL + PG_CA_CERT_B64 below.
DATABASE_URL="postgresql://app:password@db:5432/app?schema=public"
# Direct (non-pooled) Postgres connection used by Prisma Migrate/introspection.
# Same as DATABASE_URL for the self-hosted setup; only differs from it when
# using a managed provider with a separate pooler endpoint.
DIRECT_URL="postgresql://app:password@db:5432/app?schema=public"
# Base64-encoded CA certificate for Postgres SSL -- only needed for managed
# providers that require it (e.g. some Supabase setups). Leave empty for the
# self-hosted docker-compose.prod.yml setup.
PG_CA_CERT_B64=
# Only used by docker-compose.prod.yml's `db` service (self-hosted Postgres).
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

NODE_ENV=production

# Public base URLs for the three sub-apps (landing, CRM, LMS). Used as
# fallbacks when no request Host header is available (e.g. background jobs).
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CRM_URL=https://crm.example.com
NEXT_PUBLIC_LMS_URL=https://lms.example.com
# Optional override for the landing base URL (takes precedence over NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_APP_URL=

# Social/contact links rendered in the landing footer (optional)
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
# MAX messenger link for the floating 1-click contact widget (optional,
# falls back to https://max.ru when unset)
NEXT_PUBLIC_MAX_URL=

# Yandex.Metrika counter ID for landing analytics (optional). When empty,
# no Metrika script is injected and goal-tracking calls are no-ops.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_YM_COUNTER_ID=

# YooKassa payment provider.
# YOOKASSA_SECRET_KEY: "mock" or empty = mock checkout (dev only);
# "test_..." = YooKassa sandbox; "live_..." = real payments (requires
# ALLOW_LIVE_PAYMENTS=true as an explicit opt-in).
YOOKASSA_SECRET_KEY=
YOOKASSA_SHOP_ID=
# Set to "true" to allow real (non-mocked) payments
ALLOW_LIVE_PAYMENTS=false
# Shared secret appended to the webhook URL (?secret=... or Basic-auth in the
# URL registered at YooKassa). Strongly recommended in production.
YOOKASSA_WEBHOOK_SECRET=
# Set to "true" ONLY if x-forwarded-for is not trustworthy in your deployment
# and webhook protection relies on YOOKASSA_WEBHOOK_SECRET instead of the
# YooKassa source-IP allowlist.
YOOKASSA_WEBHOOK_SKIP_IP_CHECK=false

# Telegram bot used for CRM notifications (debt reminders, payment receipts,
# lesson reminders). App-scoped so it doesn't collide with the landing
# sub-app's own bot token. When empty, a mock provider logs notifications
# via the structured logger instead.
CRM_TELEGRAM_BOT_TOKEN=
# Resend API key + from-address used as an email fallback when a Telegram
# send fails and the recipient has an email on file. Both required together
# in production; optional in dev (fallback is simply skipped when unset).
CRM_RESEND_API_KEY=
CRM_NOTIFICATION_FROM_EMAIL=

# Secret pepper mixed into hashed IP addresses (rate limiting AND the ConsentLog
# audit trail — see src/landing/lib/request-ip.ts). Falls back to a hardcoded
# default if unset, which defeats the purpose of hashing — always set this in
# every deployed environment.
RATE_LIMIT_IP_SALT=

# Session cookie configuration
COOKIE_NAME=otsek_session
COOKIE_SECRET=
SESSION_TTL_HOURS=24

# Cloudflare R2 (S3-compatible) storage for LMS assets
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_UPLOAD_TTL_SECONDS=120
R2_VIEW_TTL_SECONDS=7200

# Legacy Google Gemini API key. No longer called directly (readiness-service.ts
# and app/landing/api/ai/chat's route both now call DeepSeek) — kept only as
# a fallback value for DEEPSEEK_API_KEY if that's unset, to ease migration.
GEMINI_API_KEY=

# DeepSeek API key (OpenAI-compatible client) used by both AI call sites:
# src/landing/lib/ai/readiness-service.ts and app/landing/api/ai/chat/route.ts.
# Falls back to GEMINI_API_KEY if unset.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Shared secret for cron routes (e.g. /api/cron/lesson-reminders on the CRM host)
CRON_SECRET=
